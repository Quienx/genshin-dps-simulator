      "id": "set-two-piece",
      "label": "2-piece",
      "value": "When a nearby party member triggers a Nightsoul Burst, the equipping character regenerates 6 Elemental Energy.",
      "flag": "scroll2"
    },
    {
      "id": "set-four-piece",
      "label": "4-piece",
      "value": "After the equipping character triggers a reaction related to their Elemental Type, all nearby party members gain a 12% Elemental DMG Bonus for the Elemental Types involved in the elemental reaction for 15s. If the equipping character is in the Nightsoul's Blessing state when triggering this effect, all nearby party members gain an additional 28% Elemental DMG Bonus for the Elemental Types involved in the elemental reaction for 20s. The equipping character can trigger this effect while off-field, and the DMG bonus from Artifact Sets with the same name do not stack.",
      "flag": "scroll4",
      "note": "Simulated on her own Overloaded (Pyro and Electro DMG) and Melt (Pyro and Cryo DMG). Not simulated: an Overloaded and a Melt buff on the same element do not stack in-game; here they would."
    }
  ],
  "blocks": [
    {
      "id": "scrollReaction",
      "type": "status",
      "source": "artifact",
      "label": "Scroll 4-piece: reaction buff",
      "ifFlag": "scroll4",
      "durationFrames": 900
    },
    {
      "id": "scrollNightsoul",
      "type": "status",
      "source": "artifact",
      "label": "Scroll 4-piece: Nightsoul buff",
      "ifFlag": "scroll4",
      "durationFrames": 1200
    },
    {
      "id": "scroll-4pc-trigger",
      "type": "trigger",
      "source": "artifact",
      "label": "Overloaded: Pyro / Electro DMG for the party",
      "ifFlag": "scroll4",
      "when": {
        "hit": "reaction:Overloaded"
      },
      "do": [
        {
          "applyStatus": "scrollReaction"
        },
        {
          "applyStatus": "scrollNightsoul",
          "if": {
            "status": "nightsoulBlessing"
          }
        }
      ]
    },
    {
      "id": "scroll-4pc",
      "type": "bonus",
      "source": "artifact",
      "label": "Scroll 4-piece: +12% Pyro / Electro DMG (Overloaded)",
      "ifFlag": "scroll4",
      "stat": "dmgBonus",
      "value": 12,
      "match": {
        "elements": ["Pyro", "Electro"]
      },
      "while": {
        "scrollReaction": {
          "gte": 1
        }
      },
      "teamBuff": "everyone"
    },
    {
      "id": "scroll-4pc-nightsoul",
